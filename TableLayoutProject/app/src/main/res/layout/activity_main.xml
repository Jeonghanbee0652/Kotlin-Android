<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCF5F7"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TableLayout 실습"
        android:textColor="#2BA6C4"
        android:textSize="20sp"
        android:textStyle="bold|italic" />

    <!-- 테이블 레이아웃 : 2행 2열 (입력칸 | 그림) -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:stretchColumns="1">

        <TableRow
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtCount1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFB08A6E"
                android:gravity="center"
                android:hint="?"
                android:inputType="number"
                android:maxLength="2"
                android:minWidth="56dp"
                android:minHeight="56dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvPics1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:textSize="30sp" />
        </TableRow>

        <TableRow android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtCount2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFB08A6E"
                android:gravity="center"
                android:hint="?"
                android:inputType="number"
                android:maxLength="2"
                android:minWidth="56dp"
                android:minHeight="56dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvPics2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:textSize="30sp" />
        </TableRow>
    </TableLayout>

    <Button
        android:id="@+id/btnResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="결과보기"
        android:textSize="18sp"
        app:backgroundTint="#2BA6C4" />
</LinearLayout>